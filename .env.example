# Cursor Cloud / self-hosted worker
CURSOR_API_KEY=

# Public site — KODA blog
WP_SITE_URL=https://koda-fd.ru/blog
WP_ADMIN_URL=https://koda-fd.ru/blog/wp-admin
PUBLIC_SITE_URL=https://koda-fd.ru/blog

# Excalibur BLOG publish
EXCALIBUR_BLOG_ALLOW_PUBLISH=no
EXCALIBUR_TOPIC_ID=
EXCALIBUR_PROJECT_ROOT=

# FTP (WP theme + uploads) — заполнить из хостинга
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# FTP_ROOT — каталог с wp-load.php (часто /blog/ или /public_html/blog/)

# MCP (обложки) — через Cursor MCP KV, не коммитить токен
# MCP_KV_TOKEN=

# Конверсия (для справки агентов, не секрет)
KODA_TELEGRAM_URL=https://t.me/finance_modern
KODA_CLUB_URL=https://club.koda-fd.ru/
KODA_PAYMENT_BOT_URL=https://club.koda-fd.ru/

# Telegram topic approval (Cloud Secrets / site.env.local — не коммитить значения)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
