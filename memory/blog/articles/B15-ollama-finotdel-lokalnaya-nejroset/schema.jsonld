    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/ollama-finotdel-lokalnaya-nejroset/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая видеокарта нужна для Ollama?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Желательна совместимая GPU с достаточным объёмом памяти под выбранную модель – так быстрее. Точную минимальную карту под каждую модель смотрите в карточке модели: важнее вместить веса, чем бренд."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли запускать Ollama только на CPU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Ответ будет медленнее. Для черновиков финотдела это часто приемлемо, для интерактива здесь и сейчас – раздражает."
          }
        },
        {
          "@type": "Question",
          "name": "Ollama бесплатна?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сам движок – да, open source. Веса моделей качаются отдельно и у каждой своя лицензия; электричество и железо – ваши."
          }
        },
        {
          "@type": "Question",
          "name": "Чем локальная модель хуже ChatGPT?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Часто слабее на сложных рассуждениях и длинном контексте, сильнее по контролю данных. Выбор – по задаче, не по моде."
          }
        },
        {
          "@type": "Question",
          "name": "Безопасно ли скармливать выгрузки 1С в Ollama?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Безопаснее, чем слать их в облако, но не значит можно всё. Ограничьте доступ к папке, не кладите лишние ПДн, не выставляйте API наружу."
          }
        },
        {
          "@type": "Question",
          "name": "Как связать Ollama с Cursor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Через локальный API endpoint (порт 11434) в настройках совместимого провайдера/агента или через скрипт, который дергает API. Сначала проверьте ответ curl/браузером, потом подключайте IDE."
          }
        }
      ]
    }
