    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине. Path B: по инструкции и help Cursor; первый реестр 1-2 часа с GCP и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update - около 1-2 часов. OAuth быстрее, если плагин доступен и OAuth без bug."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth - личный пилот. SA - командный реестр, минимальный blast radius: только расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write-tools; indirect injection из ячеек. Обезличивание - в гайде по ссылке выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 - скрипт в staging по cron. B92 - Agent правит через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth в облако не переезжает. Для Cloud Agents - SA в env или отдельный коннектор."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли MCP для маленького реестра?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 строк раз в месяц - хватит ручного редактирования. MCP окупается при еженедельных правках через Cursor без копипаста."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B: Google Cloud service account, mcp-gsheets в mcp.json, share реестра, сценарий find-update-re-read по doc_key и проверка через MCP Logs.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (актуальная версия)"
        },
        {
          "@type": "HowToTool",
          "name": "Node.js v20+ и npx"
        },
        {
          "@type": "HowToTool",
          "name": "mcp-gsheets (freema/mcp-gsheets)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API, service account)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Google Sheets реестр с колонкой doc_key и листом Реестр"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git (GOOGLE_APPLICATION_CREDENTIALS)"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, когда MCP Sheets нужен",
          "text": "Подключайте MCP, если реестр уже в Google Таблицах и правки повторяются каждую неделю. Не делайте Sheets единственным источником правды при жестком audit trail или сотнях таблиц с enterprise ACL.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Сделайте колонку doc_key стабильным кодом строки. В облако не кладите сырые ПДн; JSON-ключ SA только в GOOGLE_APPLICATION_CREDENTIALS, не в git. Расшарьте файл на client_email с ролью Редактор.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Настройте Path B: GCP, SA и mcp.json",
          "text": "Включите Google Sheets API, создайте service account и JSON-ключ, добавьте блок mcp-gsheets в .cursor/mcp.json или ~/.cursor/mcp.json с абсолютным путем к ключу, перезапустите Cursor и проверьте зеленый статус и MCP Logs.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Опционально подключите Path A OAuth",
          "text": "Если плагин google-sheets доступен в Marketplace: Customize → MCPs → Add → OAuth с минимальными scopes. Не считайте Connected финальной проверкой - нужен живой read/write. Для production держите Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Прогоните сценарий find-update-re-read",
          "text": "По doc_key найдите строку через sheets_get_values, approve sheets_update_values только для status и comment, затем перечитайте ту же строку и покажите diff. Human-in-the-loop на каждый write-tool обязателен.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Проверьте результат и типичные ошибки",
          "text": "После записи перечитайте диапазон. 403 - Share или путь к JSON; серый MCP - Node v20+, npx, MCP Logs; 429 - батчите; append - явно INSERT_ROWS.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Закрепите следующий шаг автоматизации",
          "text": "Оставьте Path B на одном реестре с allowlist write-tools, затем расширяйте на соседние реестры. При audit - ERP/CLM; cron-загрузки - скрипт B82.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#next-steps"
        }
      ]
    }
  ]
