    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине. Path B: по инструкции и help Cursor; первый реестр 1–2 часа с GCP и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update – около 1–2 часов. OAuth быстрее, если плагин доступен и OAuth без бага."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth – личный пилот. SA – командный реестр, минимальный blast radius: только расшаренные файлы, удобнее для Cloud Agents."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write-tools; injection из ячеек. Обезличивание – в гайде выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем это отличается от скрипта Sheets API?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Скрипт пишет в staging по cron. Здесь Agent правит через MCP без отдельного кода; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth в облако не переезжает. Для Cloud Agents – SA в env или MCP через dashboard."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли MCP для маленького реестра?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 строк раз в месяц – хватит ручного редактирования. MCP окупается при еженедельных правках через Cursor без копипаста."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
