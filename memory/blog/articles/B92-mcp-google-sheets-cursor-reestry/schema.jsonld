    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине. Path B: по инструкции и help Cursor; первый реестр 1-2 часа с GCP и Share. Path C: OAuth remote, если Preview доступен."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update - около 1-2 часов. OAuth быстрее, если плагин или remote доступны без bug."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth - личный пилот (Path A/C). SA - командный реестр, минимальный blast radius: только расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write-tools; indirect injection из ячеек. Обезличивание - в гайде по ссылке выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 - скрипт в staging по cron. B92 - Agent правит через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth в облако не переезжает. Для Cloud Agents - SA в env или отдельный коннектор."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли MCP для маленького реестра?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 строк раз в месяц - хватит ручного редактирования. MCP окупается при еженедельных правках через Cursor без копипаста."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B mcp-gsheets + service account, опционально Path A/C, сценарий find-update-re-read по doc_key и проверка через MCP Logs.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (актуальная версия, для Marketplace — min 3.13.0)"
        },
        {
          "@type": "HowToTool",
          "name": "Node.js v20+ и npx (mcp-gsheets)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Google Sheets API + service account)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Реестр в Google Sheets с doc_key и листом «Реестр»"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, когда MCP Sheets нужен финотделу",
          "text": "Подключайте MCP, если реестр уже в Google Таблицах и правки повторяются каждую неделю. Не делайте Sheets единственным источником правды при жёстком audit trail или enterprise ACL — тогда CLM/1С, таблица остаётся staging.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Одна строка = одна сущность, стабильный doc_key, лист staging для импорта. В облако без сырых ПДн; расшарьте файл только на client_email service account с ролью Редактор.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Настройте Path B: GCP, SA и mcp.json",
          "text": "Включите Google Sheets API, создайте service account и JSON-ключ, добавьте блок mcp-gsheets в .cursor/mcp.json или ~/.cursor/mcp.json с абсолютным путём к ключу, перезапустите Cursor и проверьте зелёный статус и MCP Logs.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Подключите Path A или Path C при необходимости",
          "text": "Path A: Marketplace OAuth-плагин google-sheets, если карточка в витрине. Path C: remote URL https://sheetsmcp.googleapis.com/mcp/v1. Для production финконтура держите Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a-c"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Прогоните сценарий find → update → re-read",
          "text": "По doc_key найдите строку через get_values, approve update только status/comment, затем перечитайте ту же строку и покажите diff. Не включайте Auto-run всех write-tools на пилоте.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Проверьте результат и типичные ошибки",
          "text": "Чеклист: Share на client_email, абсолютный путь в env, Node v20+, MCP Logs. 403 — нет Share; серый MCP — логи; 429 — батчите; append — явно INSERT_ROWS.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        }
      ]
    }
  ]
