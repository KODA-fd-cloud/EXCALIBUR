    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A – да для пилота, если Sheets в витрине. Path B – по инструкции; первый реестр 1–2 часа с GCP и Share. Path C – GCP + OAuth по доке Google."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update – около 1–2 часов. OAuth быстрее, если плагин доступен."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth – личный пилот (A/C). SA – командный реестр: только явно расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write; учтите injection из ячеек."
          }
        },
        {
          "@type": "Question",
          "name": "Чем отличается от скрипта Sheets API?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Скрипт (B82) пишет по cron. Здесь Agent правит через MCP без своего кода; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Есть ли официальный Google Sheets MCP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да – remote sheetsmcp.googleapis.com (preview). Для финконтура на сентябрь 2026 надежнее mcp-gsheets + SA."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth не переезжает. Нужен SA в env или MCP из Cloud / Team dashboard."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
