    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если OAuth проходит. Path B: по инструкции и help Cursor; первый реестр около 1–2 часов с GCP и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update – около 1–2 часов. OAuth-плагин быстрее, если витрина и логин живы."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth – личный пилот. SA – командный реестр и минимальный blast radius: только расшаренные файлы. Для финконтура рекомендую SA."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write-tools; следите за indirect injection из ячеек. Обезличивание – в гайде по ссылке выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем это отличается от скрипта Sheets API?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Скрипт пишет в staging по cron. Здесь Agent в Cursor правит через MCP без отдельного кода; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth в облако не переезжает. Для Cloud Agents нужен SA в env или отдельный коннектор в Team Integrations."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое official Sheets MCP Google?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Remote URL https://sheetsmcp.googleapis.com/mcp/v1 (Developer Preview, OAuth в своем GCP). Для финконтура это Path C в FAQ, не основной маршрут: сначала Path B на одном реестре."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Подключить mcp-gsheets через service account, расшарить реестр, проверить MCP Logs и прогнать сценарий find-update-re-read по doc_key.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (Customize → MCPs, Agent)"
        },
        {
          "@type": "HowToTool",
          "name": "Node.js v20+ и npx"
        },
        {
          "@type": "HowToTool",
          "name": "mcp-gsheets (freema/mcp-gsheets)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + service account)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Реестр в Google Sheets с колонкой doc_key и листом staging"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git (GOOGLE_APPLICATION_CREDENTIALS)"
        },
        {
          "@type": "HowToSupply",
          "name": "Проектный .cursor/mcp.json или глобальный ~/.cursor/mcp.json"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, когда MCP Sheets нужен финотделу",
          "text": "Подключайте MCP, если реестр уже в Google Таблицах и правки повторяются каждую неделю. Зафиксируйте DoD: найти строку по doc_key, сменить status/comment, перечитать. Не делайте Sheets единственным источником правды при жёстком audit trail.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Одна строка = одна сущность; колонка doc_key стабильна. В облако – ИНН и суммы, без паспортов и payroll ПДн. Отдельный SA, share одного файла ролью «Редактор», JSON-ключ не в git. Учитывайте indirect prompt injection из ячеек.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Настройте Path B: GCP, SA и mcp.json",
          "text": "Включите Google Sheets API, создайте service account и JSON-ключ, расшарьте реестр на client_email. Добавьте блок mcp-gsheets в mcp.json с абсолютным путём к ключу, перезапустите Cursor, проверьте зелёный статус и sheets_check_access / чтение A1:C5.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Опционально: Path A Marketplace OAuth",
          "text": "Для личного пилота: Customize → MCPs → Google Sheets → Add → OAuth. На сентябрь 2026 Error 400 на cursor:// частый; обход – логин через cursor.com/agents. Connected ≠ authorized; для командного реестра держите Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Прогоните сценарий: найти, обновить, перечитать",
          "text": "По doc_key найдите строку через get_values, approve update только status/comment, перечитайте ту же строку и сверьте diff. Human-in-the-loop на каждый write-tool; без Auto-run write без allowlist.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Проверьте результат и типичные ошибки",
          "text": "После каждой записи – перечитка. Типично: 403 без Share, серый MCP из-за Node/пути, 429 без батчей, append без INSERT_ROWS, OAuth Error 400. Чеклист: share / env / MCP Logs / re-read.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        }
      ]
    }
  ]
