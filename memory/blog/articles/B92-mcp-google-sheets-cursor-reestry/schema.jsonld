    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине. Path B: по инструкции; первый реестр 1–2 часа с GCP и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update – около 1–2 часов. OAuth быстрее при доступном плагине."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth – личный пилот. SA – командный реестр и blast radius только на расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write; следите за injection из ячеек."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 – скрипт по cron. B92 – Agent через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое sheetsmcp.googleapis.com?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Официальный remote MCP Google (Path C): url + OAuth в GCP. Для первого реестра хватит Path B."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth не переезжает. Нужен SA в env или коннектор в Cloud Agents dashboard."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B mcp-gsheets + service account (или Path A OAuth / Path C sheetsmcp): подготовка реестра, mcp.json, сценарий find-update-re-read по doc_key и проверка через MCP Logs.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (актуальная версия)"
        },
        {
          "@type": "HowToTool",
          "name": "Node.js v20+ и npx (mcp-gsheets)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + service account)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Реестр в Google Sheets с колонкой doc_key"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, когда MCP Sheets нужен финотделу",
          "text": "Подключайте MCP, если реестр уже в Google Таблицах и правки еженедельные. Не делайте Sheets единственным источником правды при жёстком audit trail – тогда CLM/1С, таблица остаётся staging. Для production финконтура выбирайте Path B (mcp-gsheets + SA).",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Одна строка = одна сущность, стабильный doc_key, лист staging для импорта. Без сырых ПДн; SA видит только расшаренные файлы; JSON-ключ не в git; учитывайте indirect prompt injection из ячеек.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Настройте Path B: GCP, SA и mcp.json",
          "text": "Включите Google Sheets API, создайте service account и JSON-ключ, расшарьте реестр на client_email ролью «Редактор». Добавьте блок mcp-gsheets в .cursor/mcp.json или ~/.cursor/mcp.json с абсолютным путём к ключу, перезапустите Cursor и проверьте зелёный статус / MCP Logs.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Подключите Path A или кратко Path C",
          "text": "Path A: Customize → MCPs → Google Sheets → OAuth, если плагин в витрине. Path C (advanced): url https://sheetsmcp.googleapis.com/mcp/v1 + OAuth в GCP. Для первого реестра достаточно Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Прогоните сценарий find → update → re-read",
          "text": "По doc_key найдите строку через sheets_get_values, approve sheets_update_values только для status/comment, затем перечитайте ту же строку и покажите diff. Human approval на каждый write обязателен.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Проверьте результат и типичные ошибки",
          "text": "Чеклист: Share / env / MCP Logs / re-read. 403 – нет Share или неверный путь к JSON; серый MCP – Node v20+ и абсолютный путь; 429 – батчите записи.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Закрепите регламент и следующие шаги",
          "text": "Allowlist write-tools, SA-ключ вне git, соседние реестры через MCP. При audit – ERP/CLM; для cron – скрипт B82.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#next-steps"
        }
      ]
    }
  ]
}
