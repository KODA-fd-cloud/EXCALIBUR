      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (актуальная версия)"
        },
        {
          "@type": "HowToTool",
          "name": "mcp-gsheets (npx mcp-gsheets@latest)"
        },
        {
          "@type": "HowToTool",
