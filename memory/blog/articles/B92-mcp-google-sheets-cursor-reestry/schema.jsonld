          "name": "Node.js v20+ и npx"
        },
        {
          "@type": "HowToTool",
          "name": "mcp-gsheets (freema)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + service account)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Реестр в Google Sheets с колонкой doc_key без сырых ПДн"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Создайте проект и включите Google Sheets API",
          "text": "Создайте проект на console.cloud.google.com → Enable APIs → Google Sheets API.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Создайте service account и JSON-ключ",
          "text": "IAM → Create → Keys → JSON. Скопируйте client_email, файл ключа храните вне git.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Расшарьте реестр на client_email",
          "text": "Расшарьте файл реестра на client_email ролью «Редактор», снимите «Уведомить». Без Share будет 403.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Добавьте блок mcp-gsheets в mcp.json",
          "text": "В .cursor/mcp.json (проект) или ~/.cursor/mcp.json добавьте сервер mcp-gsheets с npx -y mcp-gsheets@latest и абсолютным путём GOOGLE_APPLICATION_CREDENTIALS.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Перезапустите Cursor и проверьте MCP",
          "text": "После правки mcp.json перезапустите Cursor. Customize → MCPs → зелёный статус; ошибки смотрите в Output → MCP Logs. Вызовите sheets_check_access или чтение A1:C5 листа «Реестр».",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Прогоните find → update → re-read",
          "text": "По doc_key найдите строку через sheets_get_values, approve sheets_update_values только для status/comment, сразу перечитайте строку и сверьте diff. На пилоте не включайте Auto-run всех write.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        }
      ]
    }
