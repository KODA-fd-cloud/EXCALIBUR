    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: пилот, если плагин в витрине. Path B: 1-2 часа с GCP и Share по инструкции. Path C: нужен OAuth client в GCP."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update - около 1-2 часов. OAuth быстрее, если плагин доступен."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth - личный пилот (A/C). SA (Path B) - командный реестр и минимальный blast radius: только расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права Google; SA = все расшаренные таблицы. Без сырых ПДн; approve write; injection из ячеек. Обезличивание - в гайде выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 - скрипт в staging по cron. B92 - Agent через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth не переезжает. Для Cloud Agents - SA в env или коннектор в dashboard."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли MCP для маленького реестра?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 строк раз в месяц - хватит ручного редактирования. MCP окупается при еженедельных правках без копипаста."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B: service account, share реестра, mcp-gsheets в mcp.json, проверка MCP Logs и сценарий find-update-re-read по doc_key без копипаста.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (актуальная версия)"
        },
        {
          "@type": "HowToTool",
          "name": "mcp-gsheets (npx mcp-gsheets@latest)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + service account)"
        },
        {
          "@type": "HowToTool",
          "name": "Node.js v20+"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Реестр в Google Sheets с колонкой doc_key и листом staging"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git (абсолютный путь в env)"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, когда MCP Sheets нужен финотделу",
          "text": "Подключайте, если реестр уже в Sheets и правки повторяются. Для production берите Path B (mcp-gsheets + SA). Path A - только пилот с проверкой витрины. Не делайте MCP на весь Drive ради одного файла.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Одна строка = одна сущность, колонка doc_key как ключ поиска. В облако без сырых ПДн. Создайте отдельный SA, расшарьте реестр на client_email с ролью Редактор без «Уведомить»; JSON-ключ не в git.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Настройте Path B: Cloud, SA и mcp.json",
          "text": "Включите Google Sheets API, создайте service account и JSON-ключ, расшарьте реестр. Добавьте блок mcp-gsheets в .cursor/mcp.json или ~/.cursor/mcp.json с абсолютным путем к ключу. Перезапустите Cursor, проверьте зеленый статус и MCP Logs; не включайте Auto-run всех write на пилоте.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Path A и Path C только с disclaimer",
          "text": "Path A (Marketplace OAuth) и Path C (remote sheetsmcp.googleapis.com) - опции с OAuth. «Connected» не равен авторизации: нужен живой read/write. Для production оставайтесь на Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Прогоните сценарий find-update-re-read",
          "text": "На листе Реестр найдите строку по doc_key, обновите только status/comment с approval write-tool, перечитайте ту же строку и покажите diff. Не трогайте другие листы и колонки.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Проверьте результат и типичные ошибки",
          "text": "Чеклист: Share на client_email, env с абсолютным путем, MCP Logs, re-read. 403 - нет Share; серый MCP - Node/npx/путь; 429 - батчите запросы. Не чините 403 промптом без Share.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Закрепите эксплуатацию",
          "text": "Allowlist write-tools, ключ SA вне git, соседние реестры через MCP. При росте заявок или audit - ERP/n8n, Sheets как staging; cron-пакеты - скрипт B82.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#next-steps"
        }
      ]
    }
  ]
