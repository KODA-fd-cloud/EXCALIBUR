    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине. Path B: по инструкции – JSON и Share; первый реестр около 1–2 часов. Path C потребует OAuth consent в GCP."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update – около 1–2 часов. OAuth быстрее, если плагин доступен. Remote MCP Google – дольше из-за Preview-настройки."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth – личный пилот (Path A/C). SA – командный реестр и минимальный blast radius: только расшаренные файлы. Для финконтура выбирайте SA."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA-ключ = все расшаренные таблицы. Без сырых ПДн; подтверждайте write; учитывайте injection из ячеек. Обезличивание – в гайде выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 – скрипт пишет в staging по cron. B92 – Agent правит через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth в облако не переезжает. Для Cloud Agents – SA в env или отдельный MCP в Team → Integrations & MCP."
          }
        },
        {
          "@type": "Question",
          "name": "Official Google MCP вместо mcp-gsheets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Можно для эксперимента (Developer Preview). Для финреестров с ограниченным доступом предпочитайте Path B: mcp-gsheets + SA и share только нужного файла."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B: mcp-gsheets + service account, mcp.json, share реестра, сценарий find-update-re-read по doc_key и проверка через MCP Logs.",
      "inLanguage": "ru",
