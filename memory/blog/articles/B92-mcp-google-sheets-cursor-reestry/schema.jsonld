    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path B по инструкции: 1–2 часа на SA, Share и mcp.json; Cursor поможет с JSON. \"Вообще без GCP\" – только hosted/OAuth-пилот, не для командного финконтура."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + один тестовый update – около 1–2 часов. Hosted/OAuth быстрее для личного теста, но хуже по blast radius."
          }
        },
        {
          "@type": "Question",
          "name": "Есть ли официальный плагин Google Sheets в Cursor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На 08.09.2026 changelog Workspace описывает Drive, Gmail и Calendar. Cell-edit реестров – community MCP (mcp-gsheets) или hosted-коннектор, не \"магический\" Marketplace Sheets."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth/hosted – личный пилот. SA – командный реестр и минимальный blast radius: только расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA-ключ = доступ ко всем расшаренным таблицам. Без сырых ПДн; подтверждайте write-tools; не коммитьте JSON. Обезличивание – в гайде по ссылке выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем это отличается от интеграции Sheets API скриптом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Скрипт (B82) пишет в staging по cron. Здесь Agent в Cursor правит через MCP без кода; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Почему 403 или spreadsheet not found?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не расшарили client_email SA на файл или ошиблись в ID таблицы из URL. Проверьте Share и sheets_check_access, не новый промпт."
          }
        }
      ]
    },
