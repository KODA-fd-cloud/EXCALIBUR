    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине. Path B: по инструкции; первый реестр 1-2 часа с GCP и Share. Path C требует OAuth client - чуть больше шагов."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update - около 1-2 часов. OAuth быстрее, если плагин доступен."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth - личный пилот (Path A/C). SA - командный реестр и минимальный blast radius: только расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write; учитывайте injection из ячеек."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 - скрипт пишет в staging по cron. B92 - Agent правит через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое Google remote Sheets MCP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Официальный endpoint sheetsmcp.googleapis.com (Developer Preview). В Cursor - url + OAuth в mcp.json. Для финконтура надежнее Path B, пока preview."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да при Team MCP в Dashboard. Локальный OAuth сам не переезжает - для облака чаще SA в env."
          }
        }
      ]
    },
