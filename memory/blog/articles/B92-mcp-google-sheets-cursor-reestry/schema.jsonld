    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если плагин в витрине и OAuth проходит. Path B: по инструкции; первый реестр ~1-2 ч с GCP и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update - 1-2 часа. OAuth быстрее, если плагин доступен и без bug cursor://."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth - личный пилот. SA - командный реестр и production на сентябрь 2026: только расшаренные файлы."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все расшаренные таблицы. Без сырых ПДн; подтверждайте write; смотрите injection из ячеек."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 - скрипт в staging по cron. B92 - Agent через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальный OAuth не переезжает. Нужен SA в env или Login на cursor.com/agents."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли MCP для маленького реестра?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "5 строк раз в месяц - хватит руками. MCP окупается при еженедельных правках без копипаста."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B mcp-gsheets + service account, подготовка реестра без сырых ПДн, сценарий find-update-re-read по doc_key и проверка через MCP Logs.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor (актуальная версия, для Path A ~3.13.0+)"
        },
        {
          "@type": "HowToTool",
          "name": "Node.js v20+ и npx (mcp-gsheets)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + service account)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Sheets (реестр с колонкой doc_key)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git"
        },
        {
          "@type": "HowToSupply",
          "name": "Файл реестра, расшаренный на client_email с ролью Редактор"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, когда MCP Sheets нужен финотделу",
          "text": "Подключайте, если реестр уже в Google Таблицах и правки еженедельные. Не делайте Sheets единственной правдой при жёстком audit trail или 200–300+ активных договорах — тогда CLM/1С, таблица как staging. Для боевого реестра выбирайте Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Одна строка = одна сущность, колонка doc_key как ключ поиска, лист staging для импортов. В облако — ИНН, сумма, статус; без паспортов и сырых ПДн. Отдельный SA, Share «Редактор» без «Уведомить», JSON-ключ не в git.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Настройте Path B: Google Cloud, SA и mcp.json",
          "text": "Включите Google Sheets API, создайте service account и JSON-ключ, расшарьте реестр на client_email. Добавьте блок mcp-gsheets в .cursor/mcp.json или ~/.cursor/mcp.json с абсолютным путём к ключу, перезапустите Cursor и проверьте зелёный статус плюс sheets_check_access.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Подключите Path A только как пилот",
          "text": "Если плагин google-sheets в витрине — Customize → MCPs → Add → OAuth с минимумом scopes. На сентябрь 2026 Path A нестабилен (витрина, cursor://); production-default — Path B.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Прогоните сценарий: найти, обновить, перечитать",
          "text": "По SPREADSHEET_ID найдите строку по doc_key, обновите только status/comment через sheets_update_values с human approval, затем перечитайте ту же строку и покажите diff. Values передавайте как JSON array of arrays.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Проверьте результат и типичные ошибки",
          "text": "403 — нет Share или путь к JSON; серый MCP — MCP Logs и Node v20+; 429 — батчите; append — INSERT_ROWS; OAuth/cursor:// — Agents dashboard или Path B; serialization 400 — values только array of arrays.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Закрепите регламент и следующие шаги",
          "text": "Оставьте Path B на одном реестре с doc_key, allowlist write-tools и ключ SA вне git. Соседние реестры подключайте тем же MCP; audit — в ERP/CLM, cron — скрипт B82.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#next-steps"
        }
      ]
    }
  ]
