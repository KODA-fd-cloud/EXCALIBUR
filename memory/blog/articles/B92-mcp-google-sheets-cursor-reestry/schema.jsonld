    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Path A: да для пилота, если Sheets в витрине. Path B: по инструкции; первый реестр около 1-2 часов с GCP, Share и тестовым update."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько займет внедрение?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SA + mcp.json + тестовый update - около 1-2 часов. OAuth быстрее, только если плагин доступен."
          }
        },
        {
          "@type": "Question",
          "name": "OAuth или service account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth - личный пилот. SA - командный реестр: агент видит только расшаренные файлы, не весь Drive."
          }
        },
        {
          "@type": "Question",
          "name": "Какие риски для данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OAuth = права вашего Google; SA = все таблицы на этот email. Без сырых ПДн; подтверждайте write; следите за injection из ячеек. Обезличивание - в гайде выше."
          }
        },
        {
          "@type": "Question",
          "name": "Чем B92 отличается от B82?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "B82 - скрипт в staging по cron. B92 - Agent правит через MCP без скрипта; тот же SA и Share."
          }
        },
        {
          "@type": "Question",
          "name": "Что с официальным Google Sheets MCP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Developer Preview (sheetsmcp.googleapis.com). Для финотдела в сентябре 2026 начинайте с Path B на SA."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли в Cloud Agents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да через dashboard MCP. Локальный OAuth в облако не переезжает - планируйте SA в env."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#howto",
      "name": "Как подключить MCP к Google Sheets в Cursor и править реестры без копипаста",
      "description": "Path B: mcp-gsheets + service account, share реестра, mcp.json, проверка MCP Logs и сценарий find-update-re-read по doc_key без копипаста.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Cursor"
        },
        {
          "@type": "HowToTool",
          "name": "mcp-gsheets (npx mcp-gsheets@latest)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + service account)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Sheets"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Node.js v20+"
        },
        {
          "@type": "HowToSupply",
          "name": "JSON-ключ service account вне git"
        },
        {
          "@type": "HowToSupply",
          "name": "Реестр в Google Sheets с колонкой doc_key"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Оцените, нужен ли MCP Sheets",
          "text": "Подключайте MCP, если реестр уже в Google Таблицах и правки еженедельные. Не делайте Sheets единственным источником правды при жестком audit trail - тогда CLM/1С, таблица остается staging.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#when-needed"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Подготовьте реестр и безопасность",
          "text": "Одна строка = одна сущность, стабильный doc_key, лист staging. В облако без сырых ПДн: ИНН/сумма/статус - да; паспорт и полные ФИО - нет.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#prep-security"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Создайте GCP-проект, SA и расшарьте реестр",
          "text": "Enable Google Sheets API, создайте service account и JSON-ключ, скопируйте client_email. Поделитесь файлом реестра с ролью Редактор без Уведомить.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Добавьте mcp-gsheets в mcp.json",
          "text": "В .cursor/mcp.json или ~/.cursor/mcp.json добавьте блок mcp-gsheets с npx -y mcp-gsheets@latest, GOOGLE_PROJECT_ID и абсолютным путем GOOGLE_APPLICATION_CREDENTIALS. Ключ не коммитьте.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Перезапустите Cursor и проверьте доступ",
          "text": "Customize -> MCPs -> зеленый статус; ошибки смотрите в Output -> MCP Logs. Вызовите sheets_check_access или прочитайте A1:C5 листа Реестр. Оставьте approval на write-tools.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#setup"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Сверьте Path A и Path C",
          "text": "Path A (Marketplace OAuth) - только если Sheets в витрине. Path C (sheetsmcp.googleapis.com) - Developer Preview. Для первого реестра финотдела безопаснее Path B на SA.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#path-a-c"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Прогоните сценарий find -> update -> re-read",
          "text": "sheets_get_metadata -> найти строку по doc_key через get_values -> approve sheets_update_values только для status/comment -> снова get_values и сверка. Approval на каждый write обязателен.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#registry-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Проверьте ошибки и закрепите регламент",
          "text": "403 - Share или путь к JSON; серый MCP - Node v20+/npx/абсолютный путь; 429 - батчи. Закрепите Path B, allowlist write-tools и ротацию ключа SA.",
          "url": "https://koda-fd.ru/blog/mcp-google-sheets-cursor-reestry/#verify"
        }
      ]
    }
  ]
