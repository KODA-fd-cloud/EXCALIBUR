    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем справочник ДДС отличается от плана счетов 1С?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "План счетов – бухучёт. Справочник категорий ДДС – управленческие статьи по факту движения денег. Связать можно таблицей соответствия, копировать 1:1 не нужно: собственнику важны \"маркетинг\" и \"логистика\", а не субсчёт 26."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли завести 200 статей сразу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Можно, но на старте вредно. Ориентир – 20–25 статей, не глубже четырёх уровней; расширяйте, когда операция повторяется и заметна в обороте."
          }
        },
        {
          "@type": "Question",
          "name": "Excel или Google Sheets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Оба работают; validation по смыслу одинакова. Sheets удобнее для совместного ввода без версий \"файл_финал2.xlsx\"."
          }
        },
        {
          "@type": "Question",
          "name": "Как провести перевод между счетами?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Группа \"Перемещения\", направление \"перевод\". В отчёте перевод не попадает в выручку и не раздувает OPEX."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если нужной статьи нет в списке?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не вводить текст руками. Заявка владельцу справочника → новая строка → повторный ввод операции."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли автоматическая категоризация через AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "После справочника и validation. AI ускоряет разметку staging, но словарь статей должен быть единым. В промпт – только обезличенные строки."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#howto",
      "name": "Как завести справочник категорий ДДС, чтобы отчёты не разъезжались",
      "description": "Лист \"Справочник\" на 15–25 статей, data validation с запретом свободного ввода, правила \"Прочее\" и переводов, обучение команды и связка с план-фактом.",
      "inLanguage": "ru",
      "totalTime": "PT2H",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Google Sheets или Excel"
        },
        {
          "@type": "HowToTool",
          "name": "Проверка данных (data validation) – список из листа Справочник"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Список 15–25 управленческих статей ДДС по 4 группам"
        },
        {
          "@type": "HowToSupply",
          "name": "Лист операций / staging банковской выписки с колонкой Категория"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Выберите, сколько категорий достаточно на старте",
          "text": "Зафиксируйте 4 группы: операционная, инвестиционная, финансовая и перемещения. На старте 5–7 статей поступлений и 10–15 статей платежей (итого порядка 20–25), без копирования плана счетов 1С.",
          "url": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#start-volume"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Создайте лист \"Справочник\" и запретите свободный ввод",
          "text": "Колонки: код, группа, направление, название, активна, комментарий. На листе \"Движения\" включите проверку данных – список из Справочник!D2:D100 в режиме \"Отклонять ввод\". Задайте именованный диапазон DDS_Categories.",
          "url": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#spravochnik-validation"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Пропишите правила для \"Прочее\" и переводов между счетами",
          "text": "Не заводите \"Прочее\" как свалку; если завели – только разовые платежи с еженедельным разбором. Переводы – группа \"Перемещения\", направление \"перевод\": одна строка = одно движение денег, без раздувания выручки и OPEX.",
          "url": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#prochee-perevody"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Обучите команду одному шаблону",
          "text": "Памятка на один экран: выбор статьи из списка, модель перевода, заявка владельцу справочника если статьи нет. Запрет свободного текста в колонке категории. Раз в неделю – разбор пустых категорий и \"Прочее\".",
          "url": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#team-template"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Свяжите справочник с дашбордом и план-фактом",
          "text": "\"Движения\" → \"Отчёт\" через SUMIFS/QUERY по коду из справочника → план-факт с теми же кодами. Один DDS_Categories на всю книгу. Сверка: сумма по категориям на \"Факт\" = сумма на \"Сводка\".",
          "url": "https://koda-fd.ru/blog/spravochnik-kategorij-dds/#dashboard-plan-fakt"
        }
      ]
    }
  ]
}
