      "mainEntity": [
        {
          "@type": "Question",
          "name": "Нарушает ли использование ChatGPT закон № 152-ФЗ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, отправка нефильтрованных ПДн клиентов в OpenAI без согласия субъектов и уведомления Роскомнадзора незаконна. Обезличивайте выгрузки."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли заменить имя контрагента на Клиент А для защиты?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. ИНН, номера договоров и точные суммы сделок всё ещё позволяют идентифицировать лицо. Необходимо маскировать все уникальные идентификаторы."
          }
        },
        {
          "@type": "Question",
          "name": "Безопасен ли платный тариф ChatGPT Team или Enterprise для финансовых данных?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Тарифы Enterprise не используют запросы для обучения, но риск утечки и трансграничной передачи сохраняется. Применяйте локальный прокси или on-premise."
          }
        },
        {
          "@type": "Question",
          "name": "Какие данные из 1С категорически запрещено отправлять в публичные нейросети?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Любые файлы с персональными данными сотрудников и клиентов, а также первичные документы с точными реквизитами сделок и банковскими счетами."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли настроить автоматическое обезличивание без привлечения программистов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для Excel достаточно шаблона с формулами на скрытом листе. Для автоматизации API потребуются скрипты на Python, которые внедряются за пару часов."
          }
        },
        {
          "@type": "Question",
          "name": "Какое оборудование необходимо для запуска локальной модели типа Llama 3 для финотдела?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для Llama 3 или Qwen на 8–14 миллиардов параметров достаточно ПК с видеокартой Nvidia RTX 3060/4060 с 12 ГБ видеопамяти."
          }
        }
      ]
