    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/schet-1c-unf-telefon-http-servis/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Работает ли схема на УНФ 1.6 и 3.0?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Как идея – да. Код пилота выверен под УНФ 3.0.13.x (СчетНаОплату, ТЧ Запасы). На 1.6 пройдите все // ПРОВЕРИТЬ: имена документа, ТЧ и ставок НДС отличаются."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли программист 1С?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На установку расширения и публикацию hs – да (или сильный админ). На ежедневный счёт с телефона – нет: менеджер работает в PWA или боте."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли только Telegram без PWA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Бот бьёт в тот же HTTP-сервис. PWA удобнее формой и PDF; Telegram – запасной канал с ALLOWED_CHAT_IDS."
          }
        },
        {
          "@type": "Question",
          "name": "Чем это лучше официального мобильного УНФ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "МП – полный клиент. Пилот – один сценарий, пароль 1С на сервере, PDF сразу. Если МП уже закрывает задачу, свой контур можно не строить."
          }
        },
        {
          "@type": "Question",
          "name": "Это про счёт-фактуру и НДС 22%?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Статья про счёт на оплату. Ставку 22% в форме учесть можно; правила счёта-фактуры с 2026 – отдельная тема."
          }
        },
        {
          "@type": "Question",
          "name": "Безопасно ли светить HTTP-сервис в интернет?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для пилота – локальная сеть или облачная публикация хостера плюс отдельный пользователь и код на бэкенде. В прод: HTTPS, узкие права, whitelist, лучше исходящий контур."
          }
        },
        {
          "@type": "Question",
          "name": "Почему PDF иногда не из 1С?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В пилоте PDF часто собирает FastAPI (ReportLab). Документ в УНФ при этом настоящий; PDF – доставка на телефон. Печать БСП – запасной путь после сверки метаданных."
          }
        }
      ]
    },
