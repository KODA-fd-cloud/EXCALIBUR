    {
      "@type": "FAQPage",
      "@id": "https://koda-fd.ru/blog/claude-code-finotdel/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Безопасно ли загружать финансовые данные в Claude Code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Claude Code не отправляет файлы в облако целиком: анализирует структуру, пишет Python-скрипт и выполняет его локально. В облако уходят только метаданные."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит использование Claude Code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Claude Code входит в подписку Claude Pro — около 20 долларов в месяц (или 17 при годовой оплате)."
          }
        },
        {
          "@type": "Question",
          "name": "Нужны ли навыки программирования для работы с Claude Code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Вы описываете задачу на русском языке, агент пишет код на Python, запускает его и выдает результат."
          }
        },
        {
          "@type": "Question",
          "name": "Как запустить сохраненный Python-скрипт без повторной ИИ-генерации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Запускайте сохранённый файл через python analyse.py — расчёты выполняются без обращения к ИИ."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли настроить интеграцию Claude Code с нашей 1С?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: выгружайте данные из 1С в CSV в рабочую папку. Claude Code анализирует файлы локально; скрипты выгрузки агент поможет написать."
          }
        }
      ]
    }
  ]
