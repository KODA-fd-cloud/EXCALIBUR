          "@type": "HowToTool",
          "name": "VPS с доменом и Traefik (HTTPS / Let's Encrypt)"
        },
        {
          "@type": "HowToTool",
          "name": "Google Cloud Console (Sheets API + Drive API, Custom OAuth2)"
        },
        {
          "@type": "HowToTool",
          "name": "Telegram BotFather (Access Token)"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": ".env: DOMAIN_NAME, SUBDOMAIN, WEBHOOK_URL, N8N_ENCRYPTION_KEY, GENERIC_TIMEZONE=Europe/Moscow"
        },
        {
          "@type": "HowToSupply",
          "name": "Тестовая Google-таблица без лишних ПДн"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Выберите контур: Cloud или self-hosted",
          "text": "Перед docker compose up решите, где живут данные. Для сырых выписок и живых ИНН берите self-hosted Docker; Cloud – только на уже обезличенных срезах. Составьте список полей, которые никогда не уезжают в облако.",
          "url": "https://koda-fd.ru/blog/n8n-finotdel-ustanovka-pervyj-workflow/#cloud-vs-selfhost"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Установите n8n: Docker Compose, домен, HTTPS и WEBHOOK_URL",
          "text": "VPS + Docker, A-запись поддомена, firewall 80/443. Официальный Compose+Traefik: N8N_PROTOCOL=https, WEBHOOK_URL=https://n8n.ваш-домен/, N8N_ENCRYPTION_KEY, порт 5678 только localhost. docker compose up -d, создайте owner-аккаунт, timezone Europe/Moscow.",
          "url": "https://koda-fd.ru/blog/n8n-finotdel-ustanovka-pervyj-workflow/#install-docker"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Соберите первый workflow: Sheets → фильтр → Telegram",
          "text": "Custom OAuth2 (Sheets + Drive API), тестовая таблица без ИНН/ФИО, бот через BotFather. Цепочка: Sheets Trigger (Row added) → IF/Filter → Telegram Send a text message. Тест строкой, Active, в сообщении только дата/статья/сумма/ссылка.",
          "url": "https://koda-fd.ru/blog/n8n-finotdel-ustanovka-pervyj-workflow/#first-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Пройдите чек-лист безопасности перед продом",
          "text": "HTTPS обязателен; 5678 только localhost; encryption key и WEBHOOK_URL в порядке; бэкап volume; токены не в git; в Telegram без ИНН/ФИО; обновления pull → down → up -d.",
          "url": "https://koda-fd.ru/blog/n8n-finotdel-ustanovka-pervyj-workflow/#security-checklist"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Закрепите следующий шаг после дайджеста",
          "text": "Бэкап volume и календарь обновлений; фильтр строк «на проверку финдиру»; отдельный workflow под реестр дебиторки; позже локальная категоризация ДДС через Ollama на том же контуре.",
          "url": "https://koda-fd.ru/blog/n8n-finotdel-ustanovka-pervyj-workflow/#next-steps"
        }
      ]
    }
